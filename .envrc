# shellcheck shell=bash
#
# direnv がこのディレクトリに入ったときに読む設定。
# `direnv allow` を一度実行すると、以降 cd するだけで開発環境に入れる。

if ! has nix; then
  log_error "nix が見つかりません。README.md の手順で Nix を入れてください。"
  return 0
fi

# nix-direnv があれば使う (無くても動くが、cd のたびに flake を評価し直して遅い)。
# nix-direnv は ~/.config/direnv/direnvrc から読み込む。README.md を参照。
if ! has nix_direnv_version; then
  log_status "nix-direnv が未設定です (動作はしますが遅くなります)。README.md の 'direnv のセットアップ' を参照してください。"
fi

# これらのファイルが変わったらシェルを自動で作り直す。
watch_file flake.nix
watch_file flake.lock
watch_file nix/devshell.nix
watch_file nix/packages.nix
watch_file nix/checks.nix

use flake .

# マシン固有の設定 (トークンなど) はここに逃がす。git 管理外。
source_env_if_exists .envrc.local
